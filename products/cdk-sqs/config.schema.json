{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "queue_name"
  ],
  "properties": {
    "queue_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,75}(.fifo)?$"
    },
    "fifo": {
      "type": "boolean"
    },
    "visibility_timeout_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 43200
    },
    "dead_letter_queue": {
      "type": "boolean"
    },
    "cross_account_id": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "language": {
      "const": "javascript"
    }
  }
}
