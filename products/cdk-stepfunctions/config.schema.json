{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "state_machine_name"
  ],
  "properties": {
    "state_machine_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "workflow_type": {
      "enum": [
        "STANDARD",
        "EXPRESS"
      ]
    },
    "wait_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300
    },
    "language": {
      "const": "javascript"
    }
  }
}
