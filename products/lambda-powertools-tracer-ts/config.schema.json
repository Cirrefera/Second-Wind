{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "service_name"
  ],
  "properties": {
    "language": {
      "const": "javascript"
    },
    "service_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "capture_response": {
      "const": false
    }
  }
}
