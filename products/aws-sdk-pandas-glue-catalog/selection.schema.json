{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "language": {
      "type": "string",
      "const": "python"
    },
    "path": {
      "type": "string",
      "pattern": "^s3://"
    },
    "database": {
      "type": "string",
      "minLength": 1
    },
    "table": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "append",
        "overwrite",
        "overwrite_partitions"
      ]
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1
      }
    }
  },
  "required": [
    "language",
    "path",
    "database",
    "table",
    "rows"
  ]
}
