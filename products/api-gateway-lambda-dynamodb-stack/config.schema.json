{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "stack_name",
    "api_name",
    "allowed_origin",
    "account",
    "region"
  ],
  "properties": {
    "language": {
      "const": "javascript"
    },
    "stack_name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]{1,62}$"
    },
    "api_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "allowed_origin": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9.-]+$"
    },
    "account": {
      "type": "string",
      "pattern": "^\\d{12}$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}(-gov)?-[a-z]+-\\d$"
    }
  }
}
