{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "namespace",
    "service_name"
  ],
  "properties": {
    "language": {
      "const": "javascript"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "service_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,64}$"
    },
    "default_dimensions": {
      "type": "object",
      "maxProperties": 8,
      "additionalProperties": {
        "type": "string",
        "maxLength": 250
      }
    }
  }
}
