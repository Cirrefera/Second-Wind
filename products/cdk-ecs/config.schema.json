{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "service_name",
    "image"
  ],
  "properties": {
    "service_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,255}$"
    },
    "image": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "cpu": {
      "enum": [
        256,
        512,
        1024,
        2048,
        4096
      ]
    },
    "memory_mib": {
      "type": "integer",
      "minimum": 512,
      "maximum": 30720
    },
    "desired_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "language": {
      "const": "javascript"
    }
  }
}
