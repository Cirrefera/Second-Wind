{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "env": {
      "type": "object",
      "properties": {
        "account": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "region": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "clusterName": {
      "type": "string"
    },
    "nodeCount": {
      "type": "integer"
    },
    "language": {
      "type": "string",
      "enum": [
        "javascript"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "language"
  ]
}
