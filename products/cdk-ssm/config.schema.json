{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "parameter_name",
    "value"
  ],
  "properties": {
    "parameter_name": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$",
      "maxLength": 1011
    },
    "value": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "parameter_type": {
      "enum": [
        "String",
        "StringList"
      ]
    },
    "tier": {
      "enum": [
        "Standard",
        "Advanced"
      ]
    },
    "language": {
      "const": "javascript"
    }
  }
}
