{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudFormation template validation with cfn-lint configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "template"
  ],
  "properties": {
    "language": {
      "const": "python"
    },
    "template": {
      "type": "string",
      "minLength": 1,
      "maxLength": 262144
    },
    "region": {
      "type": "string",
      "default": "us-east-1"
    }
  }
}
