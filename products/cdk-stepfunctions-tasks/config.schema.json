{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "language",
    "state_machine_name",
    "task_type"
  ],
  "properties": {
    "state_machine_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "task_type": {
      "enum": [
        "lambda-invoke",
        "dynamodb-get",
        "dynamodb-put",
        "sns-publish",
        "sqs-send",
        "bedrock-invoke",
        "sagemaker-training"
      ]
    },
    "target_arn": {
      "type": "string",
      "pattern": "^arn:[^:]+:[^:]+:[^:]*:[0-9]{12}:.+$"
    },
    "artifacts_bucket": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$"
    },
    "artifacts_prefix": {
      "type": "string",
      "maxLength": 1024
    },
    "language": {
      "const": "javascript"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "task_type": {
            "enum": [
              "lambda-invoke",
              "dynamodb-get",
              "dynamodb-put",
              "sns-publish",
              "sqs-send"
            ]
          }
        },
        "required": [
          "task_type"
        ]
      },
      "then": {
        "required": [
          "target_arn"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "task_type": {
            "const": "sagemaker-training"
          }
        },
        "required": [
          "task_type"
        ]
      },
      "then": {
        "required": [
          "artifacts_bucket"
        ]
      }
    }
  ]
}
